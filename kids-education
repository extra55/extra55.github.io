<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>عالم المبدعين الصغار | منصة تعليمية تفاعلية للأطفال</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts (Cairo & Fredoka for playful typography) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@600;700;800;900&family=Fredoka:wght@600;700&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Canvas Confetti Library -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            pink: '#FF6B9B',
                            purple: '#9B51E0',
                            yellow: '#FFC837',
                            orange: '#FF8008',
                            blue: '#2F80ED',
                            green: '#00C9A7',
                            bg: '#FFF8F0'
                        }
                    },
                    fontFamily: {
                        cairo: ['Cairo', 'sans-serif'],
                        fredoka: ['Fredoka', 'sans-serif'],
                    },
                    boxShadow: {
                        'fun': '0 8px 0px 0px rgba(0,0,0,0.15)',
                        'fun-lg': '0 12px 0px 0px rgba(0,0,0,0.15)',
                        'fun-active': '0 2px 0px 0px rgba(0,0,0,0.15)',
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background-color: #FFF8F0;
            background-image: radial-gradient(#FFD166 1.5px, transparent 1.5px), radial-gradient(#4ECDC4 1.5px, #FFF8F0 1.5px);
            background-size: 60px 60px;
            background-position: 0 0, 30px 30px;
            user-select: none;
            -webkit-user-select: none;
        }

        .bounce-hover {
            transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .bounce-hover:hover {
            transform: translateY(-8px) scale(1.03);
        }
        .bounce-hover:active {
            transform: translateY(2px) scale(0.98);
        }

        @keyframes pulse-slow {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }
        .animate-pulse-slow {
            animation: pulse-slow 2s infinite ease-in-out;
        }

        /* Glassmorphism card effect */
        .glass-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(8px);
            border: 4px solid #FFF;
        }

        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #FFE5EC;
        }
        ::-webkit-scrollbar-thumb {
            background: #FF6B9B;
            border-radius: 10px;
        }

        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        .font-en {
            font-family: 'Fredoka', sans-serif;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between text-gray-800 antialiased selection:bg-pink-200">

    <!-- Header / Navigation Bar (Sticky at Top) -->
    <header id="main-header" class="hidden sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b-4 border-amber-300 shadow-md">
        <div class="max-w-7xl mx-auto px-3 py-2 md:py-3 flex flex-col md:flex-row justify-between items-center gap-2 md:gap-4">
            <!-- Logo & Back to Main Portal -->
            <div class="flex items-center justify-between w-full md:w-auto">
                <div class="flex items-center space-x-3 space-x-reverse cursor-pointer" onclick="showPortalHome()">
                    <div class="w-10 h-10 md:w-12 md:h-12 rounded-2xl bg-gradient-to-tr from-brand-pink to-brand-yellow flex items-center justify-center text-white text-xl md:text-2xl font-black shadow-md transform rotate-3 hover:rotate-0 transition-transform">
                        <i class="fa-solid fa-child-reaching"></i>
                    </div>
                    <div>
                        <h1 id="header-title" class="text-xl md:text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-brand-pink via-brand-purple to-brand-blue tracking-wide">
                            براعم المعرفة
                        </h1>
                        <p id="header-subtitle" class="text-[10px] md:text-xs font-bold text-amber-500">منصتي التعليمية التفاعلية</p>
                    </div>
                </div>

                <button onclick="showPortalHome()" class="md:hidden flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-amber-100 text-amber-800 font-bold text-xs border border-amber-300">
                    <i class="fa-solid fa-house"></i>
                    <span id="btn-change-lang-mobile">الرئيسية</span>
                </button>
            </div>

            <!-- Dynamic Navigation Bar Container -->
            <div class="flex items-center gap-2 w-full md:w-auto overflow-hidden">
                <nav id="nav-container" class="flex items-center gap-2 overflow-x-auto py-1 w-full md:w-auto no-scrollbar">
                    <!-- Nav items dynamically injected depending on language -->
                </nav>
                <button onclick="showPortalHome()" class="hidden md:flex items-center gap-2 px-3 py-2 rounded-xl bg-amber-100 hover:bg-amber-200 text-amber-800 font-bold text-sm transition-all border border-amber-300 whitespace-nowrap">
                    <i class="fa-solid fa-house"></i>
                    <span id="btn-change-lang">الرئيسية</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="max-w-7xl mx-auto px-4 py-6 flex-grow w-full">

        <!-- ================= MAIN PORTAL SELECTION (LANDING PAGE) ================= -->
        <section id="sec-portal" class="space-y-8 animate-fade-in my-auto py-8">
            <div class="text-center space-y-4 max-w-3xl mx-auto">
                <div class="inline-block bg-amber-300 text-amber-950 px-6 py-2 rounded-full font-black text-lg border-2 border-amber-400 shadow-md animate-bounce">
                    🌟 أهلاً بكم يا أبطال المستقبل 🌟
                </div>
                <h1 class="text-3xl md:text-6xl font-black text-purple-700 leading-tight">
                    اختر قسم التعلم المفضّل لديك
                </h1>
                <p class="text-base md:text-2xl font-bold text-gray-600">
                    تعلم اللغة العربية أو اللغة الإنجليزية بطريقة تفاعلية وممتعة بالصوت والصورة!
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto pt-6">
                <!-- Arabic Section Choice Card -->
                <div onclick="enterLanguageSection('ar')" class="bounce-hover glass-card rounded-3xl p-8 border-b-8 border-pink-500 cursor-pointer shadow-fun-lg text-center space-y-6 bg-gradient-to-b from-white to-pink-50">
                    <div class="w-28 h-28 mx-auto rounded-3xl bg-pink-500 text-white flex items-center justify-center text-6xl font-black shadow-lg">
                        ض
                    </div>
                    <div>
                        <h2 class="text-3xl font-black text-pink-600 mb-2">القسم العربي</h2>
                        <p class="text-gray-600 font-bold text-base">تعلم الحروف العربية، الأرقام، الحيوانات، والأشكال بالأصوات التفاعلية.</p>
                    </div>
                    <button class="w-full bg-pink-500 text-white font-black text-xl py-4 rounded-2xl shadow-fun hover:bg-pink-600 transition-all">
                        دخول القسم العربي <i class="fa-solid fa-arrow-left mr-2"></i>
                    </button>
                </div>

                <!-- English Section Choice Card -->
                <div onclick="enterLanguageSection('en')" class="bounce-hover glass-card rounded-3xl p-8 border-b-8 border-blue-500 cursor-pointer shadow-fun-lg text-center space-y-6 bg-gradient-to-b from-white to-blue-50">
                    <div class="w-28 h-28 mx-auto rounded-3xl bg-blue-500 text-white flex items-center justify-center text-6xl font-black font-en shadow-lg">
                        ABC
                    </div>
                    <div>
                        <h2 class="text-3xl font-black text-blue-600 mb-2 font-en">English Section</h2>
                        <p class="text-gray-600 font-bold text-base">Learn English Alphabets, Numbers, Animals & Shapes with Native Audio!</p>
                    </div>
                    <button class="w-full bg-blue-500 text-white font-black text-xl py-4 rounded-2xl shadow-fun hover:bg-blue-600 transition-all font-en">
                        Enter English Section <i class="fa-solid fa-arrow-right ml-2"></i>
                    </button>
                </div>
            </div>
        </section>


        <!-- ========================================================================= -->
        <!--                             ARABIC SECTION                                -->
        <!-- ========================================================================= -->

        <!-- ARABIC HOME -->
        <section id="sec-ar-home" class="hidden space-y-8 animate-fade-in">
            <!-- Hero Banner -->
            <div class="relative rounded-3xl bg-gradient-to-r from-purple-500 via-pink-500 to-amber-400 p-8 md:p-12 text-white overflow-hidden shadow-fun-lg border-4 border-white">
                <div class="relative z-10 max-w-2xl space-y-4">
                    <span class="inline-block bg-white/30 backdrop-blur-md px-4 py-1.5 rounded-full text-sm font-bold border border-white/50">
                        ✨ أهلاً بكم في القسم العربي!
                    </span>
                    <h2 class="text-3xl md:text-5xl font-black leading-tight drop-shadow-md">
                        مرحباً بك في عالم المغامرة والتعلم الممتع! 🎉
                    </h2>
                    <p class="text-lg md:text-xl font-bold opacity-90">
                        تعلم الحروف، الأرقام، الأشكال والحيوانات بطريقة تفاعلية ومسلية بالصوت والصورة!
                    </p>
                    <div class="pt-2 flex flex-wrap gap-4">
                        <button onclick="showSection('ar-letters')" class="bg-amber-400 text-amber-950 font-extrabold text-lg px-8 py-4 rounded-2xl shadow-fun hover:bg-amber-300 active:shadow-fun-active transition-all transform hover:-translate-y-1">
                            ابدأ التعلم الآن <i class="fa-solid fa-rocket mr-2"></i>
                        </button>
                    </div>
                </div>
                <div class="absolute -left-10 -bottom-10 opacity-20 md:opacity-40 text-9xl pointer-events-none">🎈</div>
                <div class="absolute left-1/3 top-4 opacity-30 text-7xl pointer-events-none animate-bounce">⭐</div>
            </div>

            <!-- Categories Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                <div onclick="showSection('ar-letters')" class="bounce-hover glass-card rounded-3xl p-6 border-b-8 border-pink-400 cursor-pointer shadow-xl text-center space-y-4">
                    <div class="w-20 h-20 mx-auto rounded-3xl bg-pink-100 flex items-center justify-center text-pink-500 text-4xl font-black shadow-inner">أ</div>
                    <h3 class="text-2xl font-black text-pink-600">حروف الهجاء</h3>
                    <p class="text-gray-600 font-bold text-sm">تعلم نطق الحروف العربية وكتابتها مع الأمثلة المصورة.</p>
                </div>
                <div onclick="showSection('ar-numbers')" class="bounce-hover glass-card rounded-3xl p-6 border-b-8 border-purple-400 cursor-pointer shadow-xl text-center space-y-4">
                    <div class="w-20 h-20 mx-auto rounded-3xl bg-purple-100 flex items-center justify-center text-purple-500 text-4xl font-black shadow-inner">123</div>
                    <h3 class="text-2xl font-black text-purple-600">الأرقام والعد</h3>
                    <p class="text-gray-600 font-bold text-sm">تعلم الأرقام من 1 إلى 10 وعد الفواكه والنجوم الملونة.</p>
                </div>
                <div onclick="showSection('ar-animals')" class="bounce-hover glass-card rounded-3xl p-6 border-b-8 border-amber-400 cursor-pointer shadow-xl text-center space-y-4">
                    <div class="w-20 h-20 mx-auto rounded-3xl bg-amber-100 flex items-center justify-center text-amber-500 text-4xl shadow-inner">🦁</div>
                    <h3 class="text-2xl font-black text-amber-600">عالم الحيوانات</h3>
                    <p class="text-gray-600 font-bold text-sm">استكشف حيوانات الغابة والمزرعة وأصواتها الجميلة.</p>
                </div>
                <div onclick="showSection('ar-shapes')" class="bounce-hover glass-card rounded-3xl p-6 border-b-8 border-blue-400 cursor-pointer shadow-xl text-center space-y-4">
                    <div class="w-20 h-20 mx-auto rounded-3xl bg-blue-100 flex items-center justify-center text-blue-500 text-4xl shadow-inner">🎨</div>
                    <h3 class="text-2xl font-black text-blue-600">الأشكال والألوان</h3>
                    <p class="text-gray-600 font-bold text-sm">تعرف على الألوان المبهجة والأشكال الهندسية الأساسية.</p>
                </div>
            </div>
        </section>

        <!-- ARABIC LETTERS SECTION -->
        <section id="sec-ar-letters" class="hidden space-y-6">
            <div class="bg-pink-100 rounded-3xl p-6 border-4 border-pink-300 flex flex-wrap justify-between items-center gap-4">
                <div>
                    <h2 class="text-3xl font-black text-pink-600 flex items-center gap-3">
                        <i class="fa-solid fa-font"></i> تعلم الحروف العربية
                    </h2>
                    <p class="text-pink-800 font-bold">اضغط على أي حرف لسماع صوته ورؤية الكلمة والصورة!</p>
                </div>
            </div>
            <div id="letters-grid" class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-7 gap-3 md:gap-4"></div>
        </section>

        <!-- ARABIC NUMBERS SECTION -->
        <section id="sec-ar-numbers" class="hidden space-y-6">
            <div class="bg-purple-100 rounded-3xl p-6 border-4 border-purple-300 flex flex-wrap justify-between items-center gap-4">
                <div>
                    <h2 class="text-3xl font-black text-purple-600 flex items-center gap-3">
                        <i class="fa-solid fa-arrow-1-9"></i> الأرقام والعد التفاعلي
                    </h2>
                    <p class="text-purple-800 font-bold">اضغط على الرقم لتعلم العد وسماع النطق الصحيح!</p>
                </div>
            </div>
            <div id="numbers-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4"></div>
        </section>

        <!-- ARABIC ANIMALS SECTION -->
        <section id="sec-ar-animals" class="hidden space-y-6">
            <div class="bg-amber-100 rounded-3xl p-6 border-4 border-amber-300 flex flex-wrap justify-between items-center gap-4">
                <div>
                    <h2 class="text-3xl font-black text-amber-600 flex items-center gap-3">
                        <i class="fa-solid fa-paw"></i> عالم الحيوانات
                    </h2>
                    <p class="text-amber-800 font-bold">تعرف على أصدقائنا الحيوانات وأصواتها ومعلومات عنها!</p>
                </div>
            </div>
            <div id="animals-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6"></div>
        </section>

        <!-- ARABIC SHAPES & COLORS SECTION -->
        <section id="sec-ar-shapes" class="hidden space-y-10">
            <div class="space-y-4">
                <div class="bg-blue-100 rounded-2xl p-4 border-4 border-blue-300">
                    <h2 class="text-2xl font-black text-blue-700 flex items-center gap-2">
                        <i class="fa-solid fa-palette"></i> الألوان المبهجة
                    </h2>
                </div>
                <div id="colors-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-4"></div>
            </div>
            <div class="space-y-4">
                <div class="bg-teal-100 rounded-2xl p-4 border-4 border-teal-300">
                    <h2 class="text-2xl font-black text-teal-700 flex items-center gap-2">
                        <i class="fa-solid fa-shapes"></i> الأشكال الهندسية
                    </h2>
                </div>
                <div id="shapes-grid" class="grid grid-cols-2 sm:grid-cols-4 gap-4"></div>
            </div>
        </section>

        <!-- ARABIC QUIZ SECTION -->
        <section id="sec-ar-quiz" class="hidden space-y-6">
            <div class="bg-emerald-100 rounded-3xl p-6 border-4 border-emerald-300 flex justify-between items-center flex-wrap gap-4">
                <div>
                    <h2 class="text-3xl font-black text-emerald-700 flex items-center gap-3">
                        <i class="fa-solid fa-trophy"></i> اختبر معلوماتك يا بطل!
                    </h2>
                    <p class="text-emerald-800 font-bold">أجب عن الأسئلة واجمع النقاط والنجوم 🎉</p>
                </div>
                <div class="bg-white px-6 py-3 rounded-2xl border-2 border-emerald-400 flex items-center gap-3 shadow-md">
                    <span class="text-xl font-bold text-gray-700">النقاط:</span>
                    <span id="quiz-score" class="text-3xl font-black text-emerald-600">0</span>
                    <i class="fa-solid fa-star text-amber-400 text-2xl"></i>
                </div>
            </div>

            <div class="max-w-2xl mx-auto glass-card rounded-3xl p-8 border-4 border-emerald-400 shadow-fun-lg text-center space-y-6 relative overflow-hidden">
                <div id="quiz-question-container" class="space-y-6">
                    <div class="inline-block bg-amber-100 text-amber-800 px-4 py-1.5 rounded-full font-bold text-sm border border-amber-300">
                        سؤال تفاعلي 💡
                    </div>
                    <h3 id="quiz-question" class="text-2xl md:text-3xl font-black text-gray-800 leading-snug">
                        جاري التحميل...
                    </h3>
                    <button onclick="speakCurrentQuestion('ar')" class="inline-flex items-center gap-2 bg-amber-400 hover:bg-amber-300 text-amber-950 font-black px-4 py-2 rounded-xl text-sm transition-all shadow-md">
                        <i class="fa-solid fa-volume-high"></i> استمع للسؤال مرة أخرى
                    </button>
                    <div id="quiz-options" class="grid grid-cols-2 gap-4 pt-4"></div>
                </div>

                <div id="quiz-feedback" class="hidden flex-col items-center justify-center space-y-4 py-6">
                    <div id="feedback-icon" class="text-6xl animate-bounce"></div>
                    <h4 id="feedback-text" class="text-3xl font-black"></h4>
                    <button onclick="nextQuestion('ar')" class="bg-emerald-500 hover:bg-emerald-400 text-white font-black text-xl px-8 py-3 rounded-2xl shadow-fun transition-all">
                        السؤال التالي <i class="fa-solid fa-arrow-left mr-2"></i>
                    </button>
                </div>
            </div>
        </section>




        <!-- ========================================================================= -->
        <!--                            ENGLISH SECTION                                -->
        <!-- ========================================================================= -->

        <!-- ENGLISH HOME -->
        <section id="sec-en-home" class="hidden space-y-8 animate-fade-in font-en" dir="ltr">
            <!-- Hero Banner -->
            <div class="relative rounded-3xl bg-gradient-to-r from-blue-500 via-indigo-500 to-teal-400 p-8 md:p-12 text-white overflow-hidden shadow-fun-lg border-4 border-white">
                <div class="relative z-10 max-w-2xl space-y-4">
                    <span class="inline-block bg-white/30 backdrop-blur-md px-4 py-1.5 rounded-full text-sm font-bold border border-white/50">
                        ✨ Welcome to English Fun World!
                    </span>
                    <h2 class="text-3xl md:text-5xl font-black leading-tight drop-shadow-md">
                        Learn English with Fun & Joy! 🎉
                    </h2>
                    <p class="text-lg md:text-xl font-bold opacity-90">
                        Explore Alphabets, Numbers, Animals, Colors and Shapes with Voice & Interactive Cards!
                    </p>
                    <div class="pt-2 flex flex-wrap gap-4">
                        <button onclick="showSection('en-letters')" class="bg-amber-400 text-amber-950 font-extrabold text-lg px-8 py-4 rounded-2xl shadow-fun hover:bg-amber-300 active:shadow-fun-active transition-all transform hover:-translate-y-1">
                            Start Learning Now <i class="fa-solid fa-rocket ml-2"></i>
                        </button>
                    </div>
                </div>
                <div class="absolute -right-10 -bottom-10 opacity-20 md:opacity-40 text-9xl pointer-events-none">🎈</div>
                <div class="absolute right-1/3 top-4 opacity-30 text-7xl pointer-events-none animate-bounce">⭐</div>
            </div>

            <!-- Categories Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                <div onclick="showSection('en-letters')" class="bounce-hover glass-card rounded-3xl p-6 border-b-8 border-blue-400 cursor-pointer shadow-xl text-center space-y-4">
                    <div class="w-20 h-20 mx-auto rounded-3xl bg-blue-100 flex items-center justify-center text-blue-500 text-4xl font-black shadow-inner">A</div>
                    <h3 class="text-2xl font-black text-blue-600">ABC Alphabets</h3>
                    <p class="text-gray-600 font-bold text-sm">Learn letters A to Z with native pronunciations & examples.</p>
                </div>
                <div onclick="showSection('en-numbers')" class="bounce-hover glass-card rounded-3xl p-6 border-b-8 border-purple-400 cursor-pointer shadow-xl text-center space-y-4">
                    <div class="w-20 h-20 mx-auto rounded-3xl bg-purple-100 flex items-center justify-center text-purple-500 text-4xl font-black shadow-inner">123</div>
                    <h3 class="text-2xl font-black text-purple-600">Numbers & Counting</h3>
                    <p class="text-gray-600 font-bold text-sm">Count numbers 1 to 10 with interactive items and audio.</p>
                </div>
                <div onclick="showSection('en-animals')" class="bounce-hover glass-card rounded-3xl p-6 border-b-8 border-amber-400 cursor-pointer shadow-xl text-center space-y-4">
                    <div class="w-20 h-20 mx-auto rounded-3xl bg-amber-100 flex items-center justify-center text-amber-500 text-4xl shadow-inner">🦁</div>
                    <h3 class="text-2xl font-black text-amber-600">Animal Kingdom</h3>
                    <p class="text-gray-600 font-bold text-sm">Discover cute animals, their English names and voices.</p>
                </div>
                <div onclick="showSection('en-shapes')" class="bounce-hover glass-card rounded-3xl p-6 border-b-8 border-teal-400 cursor-pointer shadow-xl text-center space-y-4">
                    <div class="w-20 h-20 mx-auto rounded-3xl bg-teal-100 flex items-center justify-center text-teal-500 text-4xl shadow-inner">🎨</div>
                    <h3 class="text-2xl font-black text-teal-600">Colors & Shapes</h3>
                    <p class="text-gray-600 font-bold text-sm">Learn bright colors and basic geometrical shapes.</p>
                </div>
            </div>
        </section>

        <!-- ENGLISH LETTERS SECTION -->
        <section id="sec-en-letters" class="hidden space-y-6 font-en" dir="ltr">
            <div class="bg-blue-100 rounded-3xl p-6 border-4 border-blue-300 flex flex-wrap justify-between items-center gap-4">
                <div>
                    <h2 class="text-3xl font-black text-blue-600 flex items-center gap-3">
                        <i class="fa-solid fa-font"></i> Learn English Alphabets
                    </h2>
                    <p class="text-blue-800 font-bold">Click on any letter to hear its sound and see word example!</p>
                </div>
            </div>
            <div id="en-letters-grid" class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-7 gap-3 md:gap-4"></div>
