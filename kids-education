        // ================= MODAL FUNCTIONALITY =================
        function openModal(list, index, type, lang = 'ar') {
            currentModalList = list;
            currentModalIndex = index;
            currentLang = lang;

            // Configure modal text translations & direction
            const modalCard = document.getElementById('modal-card');
            const btnText = document.getElementById('modal-btn-text');
            const prevText = document.getElementById('modal-prev-text');
            const nextText = document.getElementById('modal-next-text');

            if (lang === 'en') {
                modalCard.dir = 'ltr';
                modalCard.classList.add('font-en');
                btnText.innerText = "Listen to Pronunciation";
                prevText.innerText = "Previous";
                nextText.innerText = "Next";
            } else {
                modalCard.dir = 'rtl';
                modalCard.classList.remove('font-en');
                btnText.innerText = "استمع للنطق الصحيح";
                prevText.innerText = "السابق";
                nextText.innerText = "التالي";
            }

            updateModalContent();
            document.getElementById('modal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('modal').classList.add('hidden');
            window.speechSynthesis.cancel();
        }

        function updateModalContent() {
            const item = currentModalList[currentModalIndex];
            const charElem = document.getElementById('modal-char');
            const emojiElem = document.getElementById('modal-emoji');
            const titleElem = document.getElementById('modal-title');
            const subtitleElem = document.getElementById('modal-subtitle');
            const descElem = document.getElementById('modal-desc');

            if (item.char) {
                // Letter
                charElem.classList.remove('hidden');
                emojiElem.classList.add('hidden');
                charElem.innerText = item.char;
                titleElem.innerText = item.word;
                subtitleElem.innerText = (currentLang === 'en') ? `Letter ${item.char} - ${item.word}` : `حرف ${item.char} - ${item.word}`;
                descElem.innerText = item.desc;
                speak((currentLang === 'en') ? `Letter ${item.char}. ${item.word}. ${item.desc}` : `حرف ${item.char}. ${item.word}. ${item.desc}`, currentLang);
            } else if (item.num) {
                // Number
                charElem.classList.remove('hidden');
                emojiElem.classList.add('hidden');
                charElem.innerText = item.num;
                titleElem.innerText = item.name;
                subtitleElem.innerText = item.countName;
                descElem.innerText = (currentLang === 'en') ? `Let's count together: ${item.items.join(' ')}` : `هيا نعد معاً: ${item.items.join(' ')}`;
                speak((currentLang === 'en') ? `Number ${item.name}. ${item.countName}` : `الرقم ${item.name}. ${item.countName}`, currentLang);
            } else if (item.soundText) {
                // Animal
                charElem.classList.add('hidden');
                emojiElem.classList.remove('hidden');
                emojiElem.innerText = item.icon;
                titleElem.innerText = item.name;
                subtitleElem.innerText = item.soundText;
                descElem.innerText = item.desc;
                speak((currentLang === 'en') ? `This is ${item.name}. ${item.desc}` : `هذا ${item.name}. ${item.desc}`, currentLang);
            }
        }

        function playModalAudio() {
            const item = currentModalList[currentModalIndex];
            if (item.char) speak((currentLang === 'en') ? `${item.char}. ${item.word}` : `${item.char}. ${item.word}`, currentLang);
            else if (item.num) speak((currentLang === 'en') ? `${item.num}. ${item.name}` : `${item.num}. ${item.name}`, currentLang);
            else if (item.name) speak((currentLang === 'en') ? `${item.name}. ${item.soundText}` : `${item.name}. ${item.soundText}`, currentLang);
        }

        function nextModalItem() {
            currentModalIndex = (currentModalIndex + 1) % currentModalList.length;
            updateModalContent();
        }

        function prevModalItem() {
            currentModalIndex = (currentModalIndex - 1 + currentModalList.length) % currentModalList.length;
            updateModalContent();
        }


        // ================= QUIZ LOGIC =================
        function loadQuizQuestion(lang = 'ar') {
            const questions = (lang === 'en') ? enQuizQuestions : quizQuestions;
            const containerPrefix = (lang === 'en') ? 'en-' : '';

            document.getElementById(`${containerPrefix}quiz-feedback`).classList.add('hidden');
            document.getElementById(`${containerPrefix}quiz-feedback`).classList.remove('flex');
            document.getElementById(`${containerPrefix}quiz-question-container`).classList.remove('hidden');

            const qData = questions[currentQuizIndex];
            document.getElementById(`${containerPrefix}quiz-question`).innerText = qData.q;

            speak(qData.speech, lang);

            const optionsContainer = document.getElementById(`${containerPrefix}quiz-options`);
            optionsContainer.innerHTML = '';

            qData.options.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.className = 'bounce-hover bg-white hover:bg-emerald-50 text-emerald-800 border-3 border-emerald-200 font-black text-2xl py-4 rounded-2xl shadow-md transition-all';
                btn.innerText = opt;
                btn.onclick = () => checkQuizAnswer(idx, lang);
                optionsContainer.appendChild(btn);
            });
        }

        function speakCurrentQuestion(lang = 'ar') {
            const questions = (lang === 'en') ? enQuizQuestions : quizQuestions;
            const qData = questions[currentQuizIndex];
            speak(qData.speech, lang);
        }

        function checkQuizAnswer(selectedIdx, lang = 'ar') {
            const questions = (lang === 'en') ? enQuizQuestions : quizQuestions;
            const containerPrefix = (lang === 'en') ? 'en-' : '';

            const qData = questions[currentQuizIndex];
            const feedbackElem = document.getElementById(`${containerPrefix}quiz-feedback`);
            const feedbackText = document.getElementById(`${containerPrefix}feedback-text`);
            const feedbackIcon = document.getElementById(`${containerPrefix}feedback-icon`);

            document.getElementById(`${containerPrefix}quiz-question-container`).classList.add('hidden');
            feedbackElem.classList.remove('hidden');
            feedbackElem.classList.add('flex');

            if (selectedIdx === qData.correct) {
                // Correct Answer
                if (lang === 'en') {
                    enQuizScore += 10;
                    document.getElementById('en-quiz-score').innerText = enQuizScore;
                    feedbackIcon.innerText = '🎉';
                    feedbackText.innerText = 'Awesome & Great job! Well done!';
                    feedbackText.className = 'text-3xl font-black text-emerald-600 font-en';
                    speak('Awesome and Great job! Well done!', 'en');
                } else {
                    quizScore += 10;
                    document.getElementById('quiz-score').innerText = quizScore;
                    feedbackIcon.innerText = '🎉';
                    feedbackText.innerText = 'إجابة رائعة وممتازة! أحسنت يا بطل!';
                    feedbackText.className = 'text-3xl font-black text-emerald-600';
                    speak('إجابة رائعة وممتازة! أحسنت يا بطل!', 'ar');
                }

                // Confetti Celebration
                confetti({
                    particleCount: 100,
                    spread: 70,
                    origin: { y: 0.6 }
                });
            } else {
                // Wrong Answer
                if (lang === 'en') {
                    feedbackIcon.innerText = '💪';
                    feedbackText.innerText = 'Try again in the next question!';
                    feedbackText.className = 'text-3xl font-black text-amber-600 font-en';
                    speak('Try again in the next question, you can do it!', 'en');
                } else {
                    feedbackIcon.innerText = '💪';
                    feedbackText.innerText = 'حاول مرة أخرى في السؤال القادم!';
                    feedbackText.className = 'text-3xl font-black text-amber-600';
                    speak('حاول مرة أخرى في السؤال القادم، أنت تستطيع!', 'ar');
                }
            }
        }

        function nextQuestion(lang = 'ar') {
            const questions = (lang === 'en') ? enQuizQuestions : quizQuestions;
            currentQuizIndex = (currentQuizIndex + 1) % questions.length;
            loadQuizQuestion(lang);
        }

        // On Load Initializations
        window.onload = function() {
            initArabicData();
            initEnglishData();
            showPortalHome();
        };
    </script>
</body>
</html>